{
  "name": "aiims-openmrs-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "AIIMS Department of Reproductive Medicine & IVF - OpenMRS 3.x Workspace",
  "scripts": {
    "deploy:local": "npm --prefix aiims-esm-demographics-app run deploy:local",
    "validate:forms": "npm --prefix aiims-esm-demographics-app run validate:forms",
